# Escolha `local` para o PostgreSQL do Docker ou `neon` para o banco externo.
DATABASE_TARGET=local
DATABASE_URL_LOCAL=postgresql://us_agent:us_agent_local@localhost:5432/us_agent
# Não versione a URL real do Neon: ela deve ficar somente no .env ou nas variáveis do provedor.
DATABASE_URL_NEON=postgresql://neondb_owner:SUA_SENHA@SEU_ENDPOINT.neon.tech/neondb?sslmode=require
# DATABASE_URL continua suportada e tem precedência, útil para Vercel e outros deploys.
# DATABASE_URL=
# Use uma URL com pool em Vercel (por exemplo, Neon ou Supabase).
DATABASE_POOL_MAX=5
# Provedores de IA para o modo `committee`. Configure pelo menos um.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER_TIMEOUT_MS=45000
PORT=3333
US_AGENT_API_URL=http://localhost:3333/api
# Required in Vercel. Configure the same secret for the API and Python worker.
INGEST_API_KEY=replace-with-a-long-random-secret
