DATABASE_URL=postgresql://us_agent:us_agent_local@localhost:5432/us_agent
# Use a pooled connection string in Vercel (for example, Neon or Supabase).
DATABASE_POOL_MAX=5
PORT=3333
US_AGENT_API_URL=http://localhost:3333/api
# Required in Vercel. Configure the same secret for the API and Python worker.
INGEST_API_KEY=replace-with-a-long-random-secret
