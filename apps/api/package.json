{
  "name": "@us-agent/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test src/**/*.test.ts",
    "db:migrate": "tsx --env-file=../../.env src/database/migrate.ts",
    "db:import": "tsx --env-file=../../.env src/database/import-jsonl.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.7.5",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pg": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
