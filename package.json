{
  "name": "us-agent-platform",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,blue \"npm run dev -w @us-agent/api\" \"npm run dev -w @us-agent/web\"",
    "build": "npm run build -w @us-agent/api && npm run build -w @us-agent/web",
    "test": "npm run test -w @us-agent/api && npm run test -w @us-agent/web",
    "check:nfr-baseline": "tsx scripts/check-nfr-baseline.ts",
    "check:scientific-index": "node scripts/check-scientific-index.mjs",
    "evaluate:rnf": "tsx scripts/evaluate-rnf.ts",
    "evaluate:testrec": "tsx scripts/evaluate-testrec.ts",
    "check:testrec-evaluation": "node scripts/check-testrec-evaluation.mjs",
    "audit:testrec-source": "tsx scripts/audit-testrec-source.ts",
    "prepare:testrec-source": "tsx scripts/prepare-testrec-source.ts",
    "check:testrec-preparation": "node scripts/check-testrec-preparation.mjs",
    "transform:testrec-source": "tsx scripts/transform-testrec-source.ts",
    "check:testrec-transport": "node scripts/check-testrec-transport.mjs",
    "compare:testrec-sources": "tsx scripts/compare-testrec-sources.ts",
    "check:testrec-source-versions": "node scripts/check-testrec-source-versions.mjs",
    "prepare:testrec-reviewed": "tsx scripts/prepare-testrec-reviewed.ts",
    "check:testrec-reviewed": "node scripts/check-testrec-reviewed.mjs",
    "reconcile:testrec-data": "tsx scripts/reconcile-testrec-data.ts",
    "check:testrec-reconciliation": "node scripts/check-testrec-reconciliation.mjs",
    "measure:configuration": "tsx scripts/measure-configuration.ts",
    "measure:configuration-v2": "tsx scripts/measure-configuration-v2.ts",
    "check:configuration-binding": "node scripts/check-configuration-binding.mjs",
    "check:configuration-effort": "node scripts/check-configuration-effort.mjs",
    "prepare:configuration-tasks": "tsx scripts/prepare-configuration-tasks.ts",
    "check:configuration-tasks": "node scripts/check-configuration-tasks.mjs",
    "check:configuration-tasks-browser": "node scripts/check-configuration-tasks-browser.mjs",
    "check:rnf-evaluation": "node scripts/check-rnf-evaluation.mjs",
    "check:configured-nfr": "tsx scripts/check-configured-nfr.ts",
    "check:testrec-contract": "tsx scripts/check-testrec-contract.ts",
    "check:testrec-equations": "tsx scripts/check-testrec-equations.ts",
    "check:testrec-runs": "node scripts/check-testrec-runs.mjs",
    "check:testrec-browser": "node scripts/check-testrec-browser.mjs",
    "check:test-case-reviews": "node scripts/check-test-case-reviews.mjs",
    "check:test-case-catalogs": "node scripts/check-test-case-catalogs.mjs",
    "check:recommender-taxonomies": "node scripts/check-recommender-taxonomies.mjs",
    "check:recommender-definitions": "node scripts/check-recommender-definitions.mjs",
    "check:recommender-datasets": "node scripts/check-recommender-datasets.mjs",
    "check:recommendation-runs": "node scripts/check-recommendation-runs.mjs",
    "check:recommender-browser": "node scripts/check-recommender-browser.mjs",
    "check:classification-workflow": "node scripts/check-classification-workflow.mjs",
    "check:python-api": "python -B -m unittest discover -s tests -p test_api_credentials.py",
    "check:dependencies": "npm audit --audit-level=low",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @us-agent/api",
    "db:release": "node scripts/prepare-migration-release.mjs",
    "db:release:check": "node scripts/migrate-deployment.mjs --verify-files",
    "db:status:deploy": "node scripts/migrate-deployment.mjs --status",
    "db:migrate:deploy": "node scripts/migrate-deployment.mjs --apply",
    "check:deployment-migrations": "node --test scripts/deployment-migrations.test.mjs",
    "check:vercel-config": "node scripts/check-vercel-config.mjs",
    "auth:prepare-users": "node scripts/prepare-web-users.mjs",
    "auth:provision-users": "node scripts/provision-web-users.mjs",
    "check:private-web-access": "node scripts/check-private-web-access.mjs",
    "db:import": "npm run db:import -w @us-agent/api",
    "db:seed:ramos": "node --env-file=.env scripts/seed-ramos-example.mjs",
    "db:check:ramos": "tsx --env-file=.env scripts/check-ramos-example.ts"
  },
  "devDependencies": { "concurrently": "^9.2.5" }
}
